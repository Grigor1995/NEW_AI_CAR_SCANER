{
  "openapi": "3.0.3",
  "info": {
    "title": "CDA local C++ API",
    "version": "0.1.0",
    "description": "Loopback development host only; no remote OBD or payment API."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Actual local host health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "summary": "Current implementation limits",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        }
      }
    },
    "/api/v1/accounts": {
      "post": {
        "summary": "Register USER account",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 256,
                    "description": "12\u2013256 UTF-8 bytes, enforced server-side (not Unicode character count)."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "summary": "Password login",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 256,
                    "description": "12\u2013256 UTF-8 bytes, enforced server-side (not Unicode character count)."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/current": {
      "delete": {
        "summary": "Revoke current token",
        "responses": {
          "204": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Current account",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/vehicles": {
      "get": {
        "summary": "List current owner vehicles",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Vehicle"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "summary": "Create owned unverified profile",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Vehicle"
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "summary": "Read account preferences",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "put": {
        "summary": "Persist whitelisted account preferences",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Redacted operation failure"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Vehicle": {
        "type": "object",
        "required": [
          "make",
          "model",
          "year"
        ],
        "properties": {
          "make": {
            "type": "string",
            "maxLength": 80
          },
          "model": {
            "type": "string",
            "maxLength": 80
          },
          "year": {
            "type": "integer",
            "minimum": 1886
          },
          "vin": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "language",
          "units",
          "theme"
        ],
        "properties": {
          "language": {
            "enum": [
              "en",
              "hy",
              "ru",
              "fr"
            ]
          },
          "units": {
            "enum": [
              "metric",
              "imperial"
            ]
          },
          "theme": {
            "enum": [
              "dark",
              "light",
              "system"
            ]
          }
        }
      }
    }
  }
}
